# Paper PDFs — too large for git
Outputs/**/*.pdf
Outputs/**/*.jpg
Outputs/**/*.png
Outputs/**/*.json

# Stork PDFs — large binaries
Stork/**/*.pdf

# Obsidian workspace config
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Non-paper content
_NonPapers/

# OS files
.DS_Store
Thumbs.db

# User writing drafts
Writing/

# Personal Claude permissions
.claude/settings.local.json

# Obsidian agent session data (contains personal tokens)
.obsidian/plugins/agent-client/sessions/

# Python cache
__pycache__/
*.pyc

# Misc local files
SummaryReference.pdf
*.base
*.backup
