# Paper PDFs — too large for git, managed via iCloud
# Only include 3 example papers (Outputs/* allows re-inclusion, Outputs/ would block it)
Outputs/*
!Outputs/16 Monolithic 3D Integration of High Endurance/
!Outputs/10 FeFET_versus_DRAM_based_PIM_Architectures_A/
!Outputs/18 Write Disturb in Ferroelectric FETs and Its/

# Stork PDFs — large binaries
Stork/**/*.pdf

# Obsidian workspace config
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Non-paper content
_NonPapers/

# OS files
.DS_Store
Thumbs.db

# User writing drafts
Writing/

# Personal Claude permissions
.claude/settings.local.json

# Obsidian agent session data (contains personal tokens)
.obsidian/plugins/agent-client/sessions/

# Python cache
__pycache__/
*.pyc
